{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "F11ConfigSchema",
  "type": "object",
  "required": [
    "api_version",
    "as_of",
    "shop_currency",
    "currency_exponent",
    "money_basis",
    "refund_window_days",
    "window_start_event",
    "refund_provision_rate",
    "discount_proration_policy",
    "rounding_mode",
    "custom_line_cost_policy",
    "bundle_policy",
    "tips_policy",
    "carrier_cost_source",
    "shipping_rate_card",
    "structural_zero_shipping_rules",
    "zero_fee_gateways",
    "gateway_fee_schedule",
    "gateway_fee_refund_treatment",
    "packaging_cost",
    "cogs_coverage_gate",
    "suspect_zero_cost_policy",
    "band_thresholds",
    "excluded_financial_statuses",
    "cancelled_after_fulfillment_policy",
    "test_order_policy"
  ],
  "properties": {
    "api_version": { "type": "string" },
    "as_of": { "type": "string" },
    "shop_currency": { "type": "string" },
    "currency_exponent": { "type": "integer", "minimum": 0, "maximum": 4 },
    "money_basis": { "type": "string", "enum": ["shopMoney"] },
    "refund_window_days": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "window_start_event": { "type": "string", "enum": ["processedAt", "createdAt", "fulfilledAt"] },
    "refund_provision_rate": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
    },
    "discount_proration_policy": { "type": "string", "enum": ["pro_rata", "full", "order_weight"] },
    "rounding_mode": { "type": "string", "enum": ["half_up", "half_even", "largest_remainder"] },
    "custom_line_cost_policy": { "type": "string", "enum": ["missing", "zero"] },
    "bundle_policy": { "type": "string", "enum": ["component_explosion_or_missing", "parent_only"] },
    "tips_policy": { "type": "string", "enum": ["exclude_from_merchandise_revenue", "include_revenue_zero_cost"] },
    "carrier_cost_source": { "type": "string" },
    "shipping_rate_card": { "type": "object" },
    "structural_zero_shipping_rules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "zero_fee_gateways": {
      "type": "array",
      "items": { "type": "string" }
    },
    "gateway_fee_schedule": { "type": "object" },
    "gateway_fee_refund_treatment": { "type": "string", "enum": ["retain_fixed_fee", "retain_all_fees", "full_refund_of_fees"] },
    "packaging_cost": { "type": "integer", "minimum": 0 },
    "cogs_coverage_gate": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
    "suspect_zero_cost_policy": { "type": "string", "enum": ["measured_with_flag", "treat_as_missing"] },
    "band_thresholds": {
      "type": "object",
      "required": ["high", "acceptable", "at_risk"],
      "properties": {
        "high": { "type": "number" },
        "acceptable": { "type": "number" },
        "at_risk": { "type": "number" }
      }
    },
    "excluded_financial_statuses": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cancelled_after_fulfillment_policy": { "type": "string", "enum": ["include_with_refunds", "exclude"] },
    "test_order_policy": { "type": "string", "enum": ["exclude", "include"] }
  }
}
